{
	"name": "LibreRambox",
	"productName": "LibreRambox",
	"version": "0.13.0",
	"description": "Free and Open Source messaging and emailing app that combines common web applications into one.",
	"main": "electron/main.mjs",
	"engines": {
		"node": ">=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/LibreRambox/LibreRambox.git"
	},
	"bugs": {
		"url": "https://github.com/LibreRambox/LibreRambox/issues"
	},
	"homepage": "https://github.com/LibreRambox/LibreRambox",
	"keywords": [
		"LibreRambox",
		"messaging",
		"app",
		"slack",
		"whatsapp",
		"facebook",
		"messenger",
		"telegram",
		"google",
		"hangouts",
		"skype"
	],
	"author": "LR <LibreRambox@users.noreply.github.com>",
	"license": "GPL-3.0",
	"scripts": {
		"start": "npm run build:renderer && electron .",
		"start:debug": "npm run build:renderer && electron . --enable-logging",
		"dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env-shell VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
		"build:renderer": "vite build",
		"typecheck": "tsc -p .",
		"test": "vitest run",
		"clean": "rm -rf ./dist",
		"clean:osx": "rm -rf ./dist/LibreRambox-darwin-*",
		"clean:win": "rm -rf ./dist/LibreRambox-win32-*",
		"build": "npm run build:linux && npm run build:osx && npm run build:win",
		"build:osx": "npm run build:renderer && electron-builder -p never --macos --universal --arm64",
		"build:osx64": "npm run build:renderer && electron-builder --macos --x64",
		"build:osxarm64": "npm run build:renderer && electron-builder --macos --arm64",
		"build:linux": "npm run build:renderer && electron-builder --linux --publish never",
		"build:linux64": "npm run build:renderer && electron-builder --linux --x64 --publish never",
		"build:win": "npm run build:renderer && electron-builder --win --x64 --publish never",
		"build:win64": "npm run build:renderer && electron-builder --win --x64 --publish never",
		"translations:download": "node languages.js download",
		"translations:generate": "node languages.js generate",
		"generate-services": "node generate-services.js"
	},
	"devDependencies": {
		"@dnd-kit/core": "6.3.1",
		"@dnd-kit/sortable": "10.0.0",
		"@dnd-kit/utilities": "3.2.2",
		"@electron/asar": "^4.3.1",
		"@mantine/core": "7.17.8",
		"@mantine/hooks": "7.17.8",
		"@mantine/modals": "7.17.8",
		"@mantine/notifications": "7.17.8",
		"@tabler/icons-react": "3.51.0",
		"@types/mousetrap": "1.6.15",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "6.2.1",
		"concurrently": "10.0.7",
		"cross-env": "10.1.0",
		"electron": "45.2.3",
		"electron-builder": "^26.15.3",
		"jsdom": "31.0.0",
		"mocha": "^12.0.3",
		"postcss": "8.5.32",
		"postcss-preset-mantine": "1.18.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "5.9.3",
		"vite": "6.4.5",
		"vitest": "3.2.7",
		"wait-on": "9.5.1",
		"zustand": "5.1.0"
	},
	"dependencies": {
		"@electron/remote": "^2.1.3",
		"electron-context-menu": "5.1.0",
		"electron-is-dev": "^3.0.1",
		"electron-store": "^12.0.0",
		"electron-updater": "^6.8.9",
		"mime": "^4.1.0",
		"mousetrap": "1.6.5",
		"tmp": "^0.2.7"
	},
	"volta": {
		"node": "24.21.0"
	}
}
